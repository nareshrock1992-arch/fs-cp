###############################################################################
# OMNI PLATFORM — Production Environment Configuration
###############################################################################
#
# This is the ONLY file you edit per customer deployment.
#
# Required before first boot:
#   1. Set SERVER_IP and SERVER_NAME
#   2. Change every password/secret (search for CHANGEME)
#   3. Set SIP_DOMAIN to match your FreeSWITCH SIP profile domain
#   4. Set FS_ESL_PASSWORD to match your FreeSWITCH event_socket.conf.xml
#
# Generate a secret:   openssl rand -hex 32
# Generate a password: openssl rand -base64 24 | tr -d '=+/' | cut -c1-24
#
# DO NOT commit this file to git.
###############################################################################


###############################################################################
# PLATFORM
###############################################################################

# Runtime mode — always production for deployments
NODE_ENV=production

# Server IP address — the public IP of this Debian host.
# Used for: CORS, SIP domain (when no FQDN exists yet), nginx SSL.
# REQUIRED — change from the placeholder
SERVER_IP=192.168.1.155

# Server hostname — what browsers will use in the URL.
# Step 1 (IP-only):  set SERVER_NAME=192.168.1.155   (same as SERVER_IP)
# Step 2 (domain):   set SERVER_NAME=omni.customer.com
# Changing SERVER_NAME is the ONLY change needed to switch from IP to domain.
# nginx uses this in server_name and the HTTP→HTTPS redirect.
SERVER_NAME=192.168.1.155

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info


###############################################################################
# SSL / TLS
###############################################################################

# Paths to TLS certificate and key INSIDE the nginx container.
# The ssl/ directory is mounted at /etc/nginx/ssl/ — place your files there.
#
# Self-signed (initial install):
#   cd deploy/ssl
#   openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
#     -keyout privkey.pem -out fullchain.pem -subj "/CN=${SERVER_IP}"
#
# Let's Encrypt (after domain is live):
#   certbot certonly --webroot -w ./ssl/acme -d ${SERVER_NAME}
#   Copy fullchain.pem and privkey.pem into deploy/ssl/
SSL_CERT=/etc/nginx/ssl/fullchain.pem
SSL_KEY=/etc/nginx/ssl/privkey.pem


###############################################################################
# NGINX
###############################################################################

HTTP_PORT=80
HTTPS_PORT=443


###############################################################################
# POSTGRESQL
###############################################################################

# Superuser credentials (postgres system account)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGEME_postgres_admin          # REQUIRED

# fs-cc database
CC_DB_NAME=fs_cc
CC_DB_USER=fs_cc_user
CC_DB_PASSWORD=CHANGEME_cc_db_password                   # REQUIRED

# fs-enrs database
ENRS_DB_NAME=fs_enrs
ENRS_DB_USER=fs_enrs_user
ENRS_DB_PASSWORD=CHANGEME_enrs_db_password               # REQUIRED


###############################################################################
# REDIS
###############################################################################

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_redis_password                   # REQUIRED

# Logical database separation (do not change unless you know what you are doing)
REDIS_CC_DB=0
REDIS_ENRS_DB=1


###############################################################################
# FREESWITCH — ESL (Event Socket)
###############################################################################

# The backend containers reach FreeSWITCH on the Docker host via this alias.
# host.docker.internal resolves to the host gateway IP automatically.
FS_ESL_HOST=host.docker.internal
FS_ESL_PORT=8021

# Must match /opt/freeswitch/etc/freeswitch/autoload_configs/event_socket.conf.xml
# Default FreeSWITCH password is ClueCon — change it before production.
FS_ESL_PASSWORD=CHANGEME_esl_password                    # REQUIRED

FS_ESL_RECONNECT_MS=3000


###############################################################################
# FREESWITCH — SIP
###############################################################################

# SIP domain — used for sofia/internal/<ext>@<domain> dial strings.
# Typically the server IP during initial deploy; switch to FQDN with SERVER_NAME.
# Must match the domain configured in FreeSWITCH sip_profiles.
SIP_DOMAIN=192.168.1.155


###############################################################################
# FREESWITCH — FILESYSTEM PATHS
###############################################################################
# These must match the actual paths on the Debian host running FreeSWITCH.
# Run: fs_cli -x "global_getvar conf_dir" to verify.
# Both backends receive these paths as bind mounts AND as environment variables,
# so the container sees the exact same path as the host.

FS_BASE_DIR=/opt/freeswitch

FS_CONF_DIR=/opt/freeswitch/etc/freeswitch
FS_DIALPLAN_DIR=/opt/freeswitch/etc/freeswitch/dialplan
FS_DIRECTORY_DIR=/opt/freeswitch/etc/freeswitch/directory
FS_SIP_PROFILE_DIR=/opt/freeswitch/etc/freeswitch/sip_profiles

FS_SCRIPT_DIR=/opt/freeswitch/share/freeswitch/scripts
FS_SOUND_DIR=/opt/freeswitch/share/freeswitch/sounds

# ENRS writes recordings here (ens/, ers/, ivr/ sub-directories are created automatically)
FS_RECORDING_DIR=/opt/freeswitch/var/lib/freeswitch/recordings

FS_STORAGE_DIR=/opt/freeswitch/var/lib/freeswitch/storage
FS_DB_DIR=/opt/freeswitch/var/lib/freeswitch/db
FS_LOG_DIR=/opt/freeswitch/var/log/freeswitch


###############################################################################
# FREESWITCH — ENRS INTEGRATION
###############################################################################

# URL that FreeSWITCH Lua scripts use to call the ENRS backend.
# Lua runs on the HOST, so this must be the loopback address + the backend port
# as bound on the host (127.0.0.1:4100 from the loopback port binding in compose).
ENRS_API_URL=http://127.0.0.1:4100

# TTS engine string for the FreeSWITCH speak application (engine|voice).
# mod_flite:   flite|kal          (apt: freeswitch-mod-flite)
# mod_espeak:  espeak|en          (apt: freeswitch-mod-espeak)
# mod_unimrcp: unimrcp|<profile>
FS_TTS_ENGINE=flite|kal

# SIP gateway name for outbound ENS campaign calls.
# ENS_ORIGINATE_MODE=user  → internal extensions (lab, no SIP trunk needed)
# ENS_ORIGINATE_MODE=gateway → external SIP trunk (production)
ENS_ORIGINATE_MODE=user
FS_DEFAULT_GATEWAY=default


###############################################################################
# CONTACT CENTER (fs-cc)
###############################################################################

CC_BACKEND_PORT=4000
CC_FRONTEND_PORT=80

# JWT secret for cc backend (single secret, not dual-token).
# REQUIRED — generate: openssl rand -hex 32
CC_JWT_SECRET=CHANGEME_cc_jwt_secret_min32chars           # REQUIRED
CC_JWT_EXPIRY=15m

# Sub-path routing (must match Vite build args in cc-frontend/agent-desktop Dockerfiles)
CC_BASE_PATH=/cc/
CC_SOCKET_PATH=/cc/socket.io
AGENT_BASE_PATH=/agent/


###############################################################################
# ENRS — Emergency Notification & Response System
###############################################################################

ENRS_BACKEND_PORT=4100
ENRS_FRONTEND_PORT=80

# ENRS uses a dual-token JWT system (short-lived Bearer + long-lived httpOnly cookie).
# Both secrets REQUIRED and must differ from each other and from CC_JWT_SECRET.
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGEME_enrs_access_secret_min32chars  # REQUIRED
JWT_REFRESH_SECRET=CHANGEME_enrs_refresh_secret_min32chars # REQUIRED

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Internal API key — shared secret for FreeSWITCH Lua → ENRS backend calls.
# This value MUST ALSO be set in FreeSWITCH vars.xml as FS_INTERNAL_KEY.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=CHANGEME_internal_api_key_min32chars     # REQUIRED

# File upload limits (ENRS only — CC does not use uploads)
UPLOAD_MAX_MB=200

# Sub-path routing (must match Vite build args in enrs-frontend Dockerfile)
ENRS_BASE_PATH=/enrs/
ENRS_SOCKET_PATH=/enrs/socket.io


###############################################################################
# SEED USER
###############################################################################

# First-boot admin account for ENRS.
# Created automatically on startup if it does not exist.
# Change the password immediately after first login.
SEED_ADMIN_EMAIL=admin@enrs.local
SEED_ADMIN_PASSWORD=CHANGEME_admin_password               # REQUIRED


###############################################################################
# IMAGE TAGS
###############################################################################
# Tag images with a version so rollbacks are possible.
# Increment these when you rebuild images for a new deployment.

CC_BACKEND_IMAGE=omni/cc-backend:1.0.0
CC_FRONTEND_IMAGE=omni/cc-frontend:1.0.0
AGENT_IMAGE=omni/agent-desktop:1.0.0
ENRS_BACKEND_IMAGE=omni/enrs-backend:1.0.0
ENRS_FRONTEND_IMAGE=omni/enrs-frontend:1.0.0
NGINX_IMAGE=omni/nginx:1.0.0
