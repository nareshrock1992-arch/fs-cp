###############################################################################
# OMNI PLATFORM — Environment Configuration Template
###############################################################################
#
# USAGE:
#   cp .env.example .env
#   nano .env              # edit EVERY value marked (REQUIRED)
#
# SECRET GENERATION:
#   openssl rand -hex 32     # for JWT secrets and API keys (64-char hex)
#   openssl rand -base64 24  # for passwords (32-char printable)
#
# IMPORTANT: Never commit .env to git. The .gitignore already excludes it.
#
###############################################################################

# =============================================================================
# PLATFORM
# =============================================================================

# Docker Compose project name — namespaces all containers, volumes, and networks.
# Change this only when running two Omni instances on the same Docker host.
COMPOSE_PROJECT_NAME=omni

# Node.js mode — always "production" for deployments
NODE_ENV=production

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# SERVER IDENTITY
# =============================================================================

# The IP address of this server (used by helper scripts — not read by Docker)
SERVER_IP=192.168.1.144

# The hostname browsers use to reach the platform.
#
#   Phase 1 (IP access):     SERVER_NAME=192.168.1.100
#   Phase 2 (domain access): SERVER_NAME=omni.company.com
#
# Changing SERVER_NAME is the ONLY change needed to switch from IP to domain.
# After changing, re-issue the TLS certificate and restart: docker compose restart nginx
SERVER_NAME=192.168.1.144                            # (REQUIRED)

# =============================================================================
# PORTS & TLS
# =============================================================================

HTTP_PORT=80
HTTPS_PORT=443

# Paths to certificate files INSIDE the nginx container.
# deploy/ssl/ is mounted at /etc/nginx/ssl/ in the nginx container.
# Do not change these unless you also change the volume mount in docker-compose.yml.
SSL_CERT=/etc/nginx/ssl/fullchain.pem
SSL_KEY=/etc/nginx/ssl/privkey.pem

# =============================================================================
# DOCKER IMAGES
# =============================================================================
# These must match images you have built or pulled.
# To build locally: docker compose build

CC_BACKEND_IMAGE=omni/cc-backend:1.0.0
CC_FRONTEND_IMAGE=omni/cc-frontend:1.0.0
AGENT_IMAGE=omni/agent-desktop:1.0.0
ENRS_BACKEND_IMAGE=omni/enrs-backend:1.0.0
ENRS_FRONTEND_IMAGE=omni/enrs-frontend:1.0.0
NGINX_IMAGE=omni/nginx:1.0.0

# =============================================================================
# POSTGRESQL
# =============================================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=StrongPassword123    # (REQUIRED — openssl rand -base64 24)

# Contact Center (fs-cc) database
CC_DB_NAME=fs_cc
CC_DB_USER=fs_cc_user
CC_DB_PASSWORD=fsccPassword123                      # (REQUIRED — openssl rand -base64 24)

# Emergency Notification & Response System (fs-enrs) database
ENRS_DB_NAME=fs_enrs
ENRS_DB_USER=fs_enrs_user
# "changeme" is in ENRS's rejected-values list — startup fails until you replace it.
ENRS_DB_PASSWORD=fsenrsPassword123                           # (REQUIRED — openssl rand -base64 24)

# =============================================================================
# REDIS
# =============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Admin@123                      # (REQUIRED — openssl rand -base64 24)

# Logical database index for ENRS (DB 0 is reserved for CC, unused today)
REDIS_ENRS_DB=1

# =============================================================================
# FREESWITCH — ESL (Event Socket Layer)
# =============================================================================

# The backend containers reach FreeSWITCH on the Docker host via this hostname.
# host.docker.internal is set automatically by Docker Engine >= 20.
# On older engines, set this to the host's bridge gateway IP (usually 172.30.0.1).
FS_ESL_HOST=host.docker.internal
FS_ESL_PORT=8021

# Must EXACTLY match <param name="password"> in event_socket.conf.xml.
# Default FreeSWITCH value is "ClueCon" — CHANGE IT before deploying.
FS_ESL_PASSWORD=CHANGE_ME_esl_password              # (REQUIRED — change from "ClueCon")
FS_ESL_RECONNECT_MS=3000

# =============================================================================
# FREESWITCH — SIP
# =============================================================================

# SIP domain used in originate strings: sofia/internal/<ext>@<SIP_DOMAIN>
# Phase 1: server IP.  Phase 2: FQDN.
SIP_DOMAIN=192.168.1.144                          # (REQUIRED)

# =============================================================================
# FREESWITCH — FILESYSTEM PATHS
# =============================================================================
#
# Set these to match YOUR FreeSWITCH installation. Verify with:
#   fs_cli -x "global_getvar conf_dir"
#   fs_cli -x "global_getvar scripts_dir"
#   fs_cli -x "global_getvar recordings_dir"
#
# DEBIAN PACKAGE DEFAULTS (installed from SignalWire/FreeSWITCH packages):
#   FS_BASE_DIR=/usr/share/freeswitch
#   FS_CONF_DIR=/etc/freeswitch
#   FS_DIALPLAN_DIR=/etc/freeswitch/dialplan
#   FS_DIRECTORY_DIR=/etc/freeswitch/directory
#   FS_SIP_PROFILE_DIR=/etc/freeswitch/sip_profiles
#   FS_SCRIPT_DIR=/usr/share/freeswitch/scripts
#   FS_SOUND_DIR=/usr/share/freeswitch/sounds
#   FS_RECORDING_DIR=/var/lib/freeswitch/recordings
#   FS_STORAGE_DIR=/var/lib/freeswitch/storage
#   FS_DB_DIR=/var/lib/freeswitch/db
#   FS_LOG_DIR=/var/log/freeswitch
#
# SOURCE-COMPILED TO /opt/freeswitch (defaults below):

FS_BASE_DIR=/opt/freeswitch                                     # (REQUIRED)
FS_CONF_DIR=/opt/freeswitch/etc/freeswitch                      # (REQUIRED)
FS_DIALPLAN_DIR=/opt/freeswitch/etc/freeswitch/dialplan         # (REQUIRED)
FS_DIRECTORY_DIR=/opt/freeswitch/etc/freeswitch/directory       # (REQUIRED)
FS_SIP_PROFILE_DIR=/opt/freeswitch/etc/freeswitch/sip_profiles  # (REQUIRED)
FS_SCRIPT_DIR=/opt/freeswitch/share/freeswitch/scripts          # (REQUIRED)
FS_SOUND_DIR=/opt/freeswitch/share/freeswitch/sounds            # (REQUIRED)
FS_RECORDING_DIR=/opt/freeswitch/var/lib/freeswitch/recordings  # (REQUIRED)
FS_STORAGE_DIR=/opt/freeswitch/var/lib/freeswitch/storage       # (REQUIRED)
FS_DB_DIR=/opt/freeswitch/var/lib/freeswitch/db                 # (REQUIRED)
FS_LOG_DIR=/opt/freeswitch/var/log/freeswitch                   # (REQUIRED)

# =============================================================================
# FREESWITCH — ENRS INTEGRATION
# =============================================================================

# URL that FreeSWITCH Lua scripts use to reach the ENRS backend.
# Lua runs on the HOST — this must be the host loopback address.
# Change the port only if ENRS_BACKEND_PORT is changed.
ENRS_API_URL=http://127.0.0.1:4100

# TTS engine for the FreeSWITCH "speak" application. Format: engine|voice
#   flite|kal   — mod_flite (built-in, no extra install required)
#   espeak|en   — mod_espeak
FS_TTS_ENGINE=flite|kal

# ENS outbound call origination mode:
#   gateway  — production SIP trunk (set FS_DEFAULT_GATEWAY to your gateway name)
#   user     — internal extensions only (lab / dev environments)
ENS_ORIGINATE_MODE=gateway
FS_DEFAULT_GATEWAY=default

# =============================================================================
# CONTACT CENTER (fs-cc)
# =============================================================================

CC_BACKEND_PORT=4000

# JWT signing secret for CC sessions.
# The value below contains "CHANGE-IN-PRODUCTION" — the CC backend startup guard
# checks for this exact substring and exits 1 if found.
# Replace with: openssl rand -hex 32
CC_JWT_SECRET=a73ee9904d51775e969c6e9e0d20107f9ef47dc914e7055dc2b61811d1f4a0f0                  # (REQUIRED — server refuses to start with this value)
CC_JWT_EXPIRY=15m

# Bootstrap credentials for the CC admin account.
# The account is created on first run of post-install.sh.
# Changing CC_ADMIN_PASSWORD after first run has no effect — the account
# already exists and ON CONFLICT DO NOTHING skips the re-seed.
# Change the password via the CC UI after first login.
CC_ADMIN_PASSWORD=admin123

# Sub-path routing — do not change unless you rebuild the frontend images.
#
# How the routing contract works:
#   CC_BASE_PATH   — Vite --base for the CC frontend and BrowserRouter basename.
#                    nginx strips this prefix before forwarding to cc-frontend.
#   CC_API_BASE    — API base the CC frontend (and Agent Desktop) send to the browser.
#                    nginx routes /cc/api/* → cc-backend /api/* (strips the /cc prefix).
#   CC_SOCKET_PATH — Socket.IO path. nginx routes /cc/socket.io → cc-backend.
#                    Both cc-frontend and agent-desktop use this path.
#   AGENT_BASE_PATH — Vite --base for the Agent Desktop.
CC_BASE_PATH=/cc/
CC_API_BASE=/cc/api
CC_SOCKET_PATH=/cc/socket.io
AGENT_BASE_PATH=/agent/

# File upload size limit (MB)
UPLOAD_MAX_MB=200

# =============================================================================
# ENRS — Emergency Notification & Response System
# =============================================================================

ENRS_BACKEND_PORT=4100

# JWT access token secret (Bearer, 15m lifetime).
# The value below is in ENRS's rejected-values list — startup fails until replaced.
# Replace with: openssl rand -hex 32
JWT_ACCESS_SECRET=776bbb57df053ce55b873d254e521a7a18a71f36d5777a9addddf2064e52ed5b    # (REQUIRED — server refuses to start with this value)
JWT_ACCESS_EXPIRY=15m

# JWT refresh token secret (httpOnly cookie, 7d lifetime). Must differ from JWT_ACCESS_SECRET.
# Replace with: openssl rand -hex 32
JWT_REFRESH_SECRET=96eedcaa7254f8f8c005a88d1953287eb0734ef1b4dad63118e8b2d2836d4f06  # (REQUIRED — server refuses to start with this value)
JWT_REFRESH_EXPIRY=7d

# Internal API key shared between the ENRS backend and FreeSWITCH Lua scripts.
# Must ALSO be written into FreeSWITCH vars.xml as FS_INTERNAL_KEY.
# The value below is in ENRS's rejected-values list — startup fails until replaced.
# Replace with: openssl rand -hex 32
INTERNAL_API_KEY=5683d665741111eb369ffa9b4847d6722fc24d710e5f4f730eb3b71c4ceb9f8c         # (REQUIRED — server refuses to start with this value)

# Sub-path routing — do not change unless you rebuild the frontend images.
#
# ENRS_API_BASE    — API base the ENRS frontend sends. nginx routes /enrs/api/*
#                    → enrs-backend /api/* (strips the /enrs prefix). The /v1
#                    version segment is part of the base so client.js paths like
#                    /auth/login resolve to /enrs/api/v1/auth/login.
ENRS_BASE_PATH=/enrs/
ENRS_API_BASE=/enrs/api/v1
ENRS_SOCKET_PATH=/enrs/socket.io

# =============================================================================
# ENRS SEED ADMINISTRATOR
# =============================================================================
# Created automatically on first ENRS startup if the account does not exist.
# Change the password immediately after first login.

SEED_ADMIN_EMAIL=admin@enrs.local
SEED_ADMIN_PASSWORD=Admin@12345        # (REQUIRED — change after first login)


###############################################################################
# IMAGE TAGS
###############################################################################
# Tag images with a version so rollbacks are possible.
# Increment these when you rebuild images for a new deployment.

CC_BACKEND_IMAGE=omni/cc-backend:1.0.0
CC_FRONTEND_IMAGE=omni/cc-frontend:1.0.0
AGENT_IMAGE=omni/agent-desktop:1.0.0
ENRS_BACKEND_IMAGE=omni/enrs-backend:1.0.0
ENRS_FRONTEND_IMAGE=omni/enrs-frontend:1.0.0
NGINX_IMAGE=omni/nginx:1.0.0
