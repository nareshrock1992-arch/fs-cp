# =============================================================================
# Omni Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every value marked (REQUIRED).
#
# Generate a secret:   openssl rand -hex 32
# Generate a password: openssl rand -base64 24
#
# DO NOT commit .env to git — it contains production secrets.
# =============================================================================

# ── Image tags ────────────────────────────────────────────────────────────────
# Tag your images with a version so rollbacks are possible.
# docker compose build && docker compose push  (if using a registry)
CC_VERSION=1.0.0
ENRS_VERSION=1.0.0
NGINX_VERSION=1.0.0

# ── Server identity ───────────────────────────────────────────────────────────
# nginx uses this value in server_name and in the HTTP→HTTPS redirect.
# Step 1 (IP-only):   set to your server's public IP,  e.g. 203.0.113.10
# Step 2 (domain):    set to your FQDN,               e.g. omni.company.com
# Changing this is the ONLY change needed to switch from IP to domain access.
SERVER_NAME=203.0.113.10

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Superuser password for the postgres admin account
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD   # (REQUIRED)

# fs-cc application DB user password — matches 01_users.sql
CC_DB_PASSWORD=CHANGE_ME_CC_DB_PASSWORD                    # (REQUIRED)

# fs-enrs application DB user password — matches 01_users.sql
ENRS_DB_PASSWORD=CHANGE_ME_ENRS_DB_PASSWORD                # (REQUIRED)

# ── Redis ─────────────────────────────────────────────────────────────────────
# Passed to redis-server via --requirepass at runtime (not stored in redis.conf)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD                    # (REQUIRED)

# ── FreeSWITCH ───────────────────────────────────────────────────────────────
# ESL password — set in /etc/freeswitch/autoload_configs/event_socket.conf.xml
FS_ESL_PASSWORD=ClueCon                                    # (REQUIRED — change from default)

# SIP domain used for call routing and SIP registrations.
# Use the server IP for IP-only deployments; switch to FQDN when domain is live.
SIP_DOMAIN=203.0.113.10

# ── fs-cc Contact Center ──────────────────────────────────────────────────────
# Allowed CORS origins for the CC backend (comma-separated).
# Must include the URL your browser uses to reach the platform.
CC_CORS_ORIGIN=https://203.0.113.10

# JWT secret — minimum 32 random characters
CC_JWT_SECRET=CHANGE_ME_CC_JWT_SECRET_MIN_32_CHARS         # (REQUIRED)
CC_JWT_EXPIRY=15m

# ── fs-enrs Emergency Notification & Response ─────────────────────────────────
# Allowed CORS origins for the ENRS backend
ENRS_CORS_ORIGIN=https://203.0.113.10

# JWT access token secret (short-lived Bearer token)
ENRS_JWT_ACCESS_SECRET=CHANGE_ME_ENRS_JWT_ACCESS_SECRET    # (REQUIRED)
ENRS_JWT_ACCESS_EXPIRY=15m

# JWT refresh token secret (long-lived httpOnly cookie)
# Must differ from the access secret
ENRS_JWT_REFRESH_SECRET=CHANGE_ME_ENRS_JWT_REFRESH_SECRET  # (REQUIRED)
ENRS_JWT_REFRESH_EXPIRY=7d

# Internal API key — shared secret for FreeSWITCH Lua → backend calls.
# Set the same value in FreeSWITCH vars.xml as <X-Var name="FS_INTERNAL_KEY"/>.
ENRS_INTERNAL_API_KEY=CHANGE_ME_INTERNAL_KEY_MIN_32_CHARS  # (REQUIRED)

# ENS outbound call mode:
#   gateway = production SIP trunk (set ENS_ORIGINATE_GATEWAY to the gateway name)
#   user    = internal extensions only (lab/dev)
ENS_ORIGINATE_MODE=gateway
ENS_ORIGINATE_GATEWAY=your-sip-gateway-name

# FreeSWITCH TTS engine for spoken announcements
ENRS_TTS_ENGINE=flite
ENRS_TTS_VOICE=kal

# Seed admin account created on first ENRS container start
SEED_ADMIN_EMAIL=admin@enrs.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD               # (REQUIRED)

# ── Shared ────────────────────────────────────────────────────────────────────
# Log level for both backends: debug | info | warn | error
LOG_LEVEL=info
