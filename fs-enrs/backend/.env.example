################################################################################
#  fs-enrs Backend — Environment Configuration
#  Copy to .env and fill in the ★ values
################################################################################

NODE_ENV=development
PORT=4100

# ── Redis (Sprint 0 infrastructure) ──────────────────────────────────────────
# Used for: token blacklist, tenant context cache, Socket.IO adapter (Sprint 12)
# Leave defaults for local dev; set REDIS_HOST=redis in Docker Compose.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=     # uncomment if Redis requires auth
# REDIS_URL=          # full URL overrides HOST/PORT/PASSWORD (e.g. redis://user:pass@host:6379/0)

# Logging level (debug | info | warn | error) — defaults to info
# LOG_LEVEL=info

# ★ Database — new fs_enrs database (separate from fs_cc)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fs_enrs
DB_USER=fs_enrs
DB_PASSWORD=changeme
DB_SSL=false

# ★ JWT secrets — generate two separate random 32+ char strings
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_STRING_access_32_chars
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_STRING_refresh_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ★ FreeSWITCH ESL — same instance as fs-cc
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=ClueCon
ESL_RECONNECT_MS=3000

# ★ Internal API key — shared secret between backend and FreeSWITCH Lua scripts
# Must match FS_INTERNAL_KEY set on the FreeSWITCH server (vars.xml or systemd env)
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_HEX_32

# ENS originate mode — how the backend dials contacts
# 'user'    = internal extensions only (lab mode, no SIP trunk needed)
# 'gateway' = external SIP gateway (production)
ENS_ORIGINATE_MODE=user

# ── ENRS IVR Deployment ───────────────────────────────────────────────────────
# URL that FreeSWITCH Lua scripts use to reach THIS backend.
# Usually http://127.0.0.1:<PORT> when FS and backend are on the same server.
# If they are on different servers, use the backend's LAN IP.
ENRS_API_URL=http://127.0.0.1:4100

# DEPRECATED — FS_TTS_ENGINE is no longer used. All TTS is handled by Piper (PIPER_BACKEND_URL).
# FreeSWITCH mod_flite is disabled. This variable has no effect and will be removed.
# FS_TTS_ENGINE=flite|kal

# SIP gateway name in FreeSWITCH used for ENS outbound campaign calls
# Run: fs_cli -x "sofia status" to see configured gateways
# Set to 'default' if you have no named gateway (internal profile routing)
FS_DEFAULT_GATEWAY=default

# Audio upload directory (local staging before copy to FS_SOUND_DIR/enrs/)
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50
#To check the freeswitch paths, run the following commands in the FreeSWITCH CLI:
#fs_cli -x "global_getvar conf_dir"
#fs_cli -x "global_getvar script_dir"
#fs_cli -x "global_getvar recordings_dir"
#fs_cli -x "global_getvar sounds_dir"
#fs_cli -x "global_getvar storage_dir"
#fs_cli -x "global_getvar db_dir"
#fs_cli -x "global_getvar log_dir"
# ── FreeSWITCH filesystem paths ───────────────────────────────────────────────
# Set these to match your FreeSWITCH installation.
# Leave unset to use the defaults (Debian/Ubuntu package layout).
#
# FS_BASE_DIR       — root share dir   (default: /usr/share/freeswitch)
# FS_CONF_DIR       — conf/            (default: /etc/freeswitch)
# FS_DIALPLAN_DIR   — conf/dialplan    (default: /etc/freeswitch/dialplan)
# FS_DIRECTORY_DIR  — conf/directory   (default: /etc/freeswitch/directory)
# FS_SIP_PROFILE_DIR— conf/sip_profiles(default: /etc/freeswitch/sip_profiles)
# FS_SCRIPT_DIR     — scripts/         (default: /usr/share/freeswitch/scripts)
# FS_SOUND_DIR      — sounds/          (default: /usr/share/freeswitch/sounds)
# FS_RECORDING_DIR  — recordings/      (default: /var/lib/freeswitch/recordings)
# FS_STORAGE_DIR    — storage/         (default: /var/lib/freeswitch/storage)
# FS_DB_DIR         — db/              (default: /var/lib/freeswitch/db)
# FS_LOG_DIR        — log/             (default: /var/log/freeswitch)
#
# ★ Uncomment and set any that differ from the defaults:
# FS_BASE_DIR=/usr/share/freeswitch
# FS_CONF_DIR=/etc/freeswitch
# FS_SCRIPT_DIR=/usr/share/freeswitch/scripts
# FS_RECORDING_DIR=/var/lib/freeswitch/recordings
################################################################################
# FreeSWITCH Installation (Dabin Development Server)
################################################################################

# Root installation
FS_BASE_DIR=/opt/freeswitch

################################################################################
# FreeSWITCH Configuration
################################################################################

FS_CONF_DIR=/opt/freeswitch/etc/freeswitch
FS_DIALPLAN_DIR=/opt/freeswitch/etc/freeswitch/dialplan
FS_DIRECTORY_DIR=/opt/freeswitch/etc/freeswitch/directory
FS_SIP_PROFILE_DIR=/opt/freeswitch/etc/freeswitch/sip_profiles

################################################################################
# FreeSWITCH Lua Scripts
################################################################################

FS_SCRIPT_DIR=/opt/freeswitch/share/freeswitch/scripts

################################################################################
# FreeSWITCH Sounds
################################################################################

FS_SOUND_DIR=/opt/freeswitch/share/freeswitch/sounds

################################################################################
# FreeSWITCH Recordings
################################################################################

FS_RECORDING_DIR=/opt/freeswitch/var/lib/freeswitch/recordings

################################################################################
# FreeSWITCH Storage
################################################################################

FS_STORAGE_DIR=/opt/freeswitch/var/lib/freeswitch/storage

################################################################################
# FreeSWITCH Database
################################################################################

FS_DB_DIR=/opt/freeswitch/var/lib/freeswitch/db

################################################################################
# FreeSWITCH Logs
################################################################################

FS_LOG_DIR=/opt/freeswitch/var/log/freeswitch
# CORS — frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:8100

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50

# ── Initial SUPER_ADMIN bootstrap ────────────────────────────────────────────
# Used ONLY when no SUPER_ADMIN exists in the database.
# Set these before first deployment; leave unset if a SUPER_ADMIN already exists.
# NEVER commit a real password here or anywhere in source control.
#
# Password requirements: ≥8 chars, uppercase, lowercase, digit, special character.
# Example:  openssl rand -base64 16   (generates a strong random password)
#
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Administrator

# ── Piper TTS service ────────────────────────────────────────────────────────
# Internal TTS synthesis service (replaces FreeSWITCH flite/espeak).
#   Docker deployment: piper service in docker-compose
#   Source-level DEV:  start-dev.sh starts piper on port 5002 (backend) / 5003 (Lua)
#
# PIPER_BACKEND_URL — URL used by the Node.js backend (campaignEngine, piperClient)
#   Docker: http://piper:5000   (Docker network service name)
#   Dev:    http://127.0.0.1:5002
PIPER_BACKEND_URL=http://piper:5000
#
# PIPER_LUA_URL — URL used by FreeSWITCH Lua scripts (ens_blast_trigger, ens_playback_handler,
#   ers_conference_bridge). Must be reachable from FreeSWITCH's network context.
#   Docker: http://127.0.0.1:5003  (host-loopback; adjust if FS runs in a container)
#   Dev:    http://127.0.0.1:5002
PIPER_LUA_URL=http://127.0.0.1:5002
#
# PIPER_DEFAULT_VOICE — default voice model for synthesis requests
# Must match a key in services/piper/src/voices.py VOICE_REGISTRY
PIPER_DEFAULT_VOICE=en_US-lessac-medium
#
# PIPER_TIMEOUT_MS — HTTP request timeout for synthesis (ms)
# lessac-medium cold synthesis takes 12-16s — keep well above that.
PIPER_TIMEOUT_MS=30000
#
# PIPER_SAMPLE_RATE — target output sample rate for FreeSWITCH playback
# 8000  = G.711 telephony (standard PSTN/SIP — safe default)
# 16000 = G.722 wideband (if FreeSWITCH codec profile supports it)
# Verify with: fs_cli -x "global_getvar default_sample_rate"
PIPER_SAMPLE_RATE=8000
#
# PIPER_MAX_CONCURRENT — max simultaneous synthesis requests to Piper
PIPER_MAX_CONCURRENT=2

# ── Legacy dev-only seed script (node src/db/seed.js) ────────────────────────
# Used only by the manual developer seed — not part of production startup.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
