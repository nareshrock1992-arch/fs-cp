################################################################################
#  FreeSWITCH Contact Center — Environment Configuration
#
#  CUSTOMER SETUP:
#    1. cp .env.example .env
#    2. Edit ONLY the four values marked ★ below
#    3. docker compose up -d
#
#  All other defaults work for a standard single-server deployment.
################################################################################


# ★ 1 ── Your server's LAN IP (the IP browsers use to reach this machine) ─────
SERVER_IP=192.168.1.x


################################################################################
# Backend
################################################################################

PORT=4000

# URL of the frontend as seen from browsers (used for CORS).
# Pattern: http://<SERVER_IP>:<FRONTEND_PORT>
CORS_ORIGIN=http://${SERVER_IP}:8000,http://${SERVER_IP}:8080


################################################################################
# Database
################################################################################

# In Docker Compose the host is always "db" (the service name).
# For local dev outside Docker set this to "localhost".
DB_HOST=db
DB_PORT=5432
DB_NAME=fs_cc
DB_USER=fs_cc

# ★ 2 ── Change this password ──────────────────────────────────────────────────
DB_PASSWORD=changeme


################################################################################
# FreeSWITCH ESL
################################################################################

# ★ 3 ── IP of your FreeSWITCH server ─────────────────────────────────────────
FS_ESL_HOST=${SERVER_IP}
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
FS_ESL_RECONNECT_MS=3000

# SIP domain / IP of the FreeSWITCH internal SIP profile.
# Used to build agent contact strings for internal extensions:
#   {sip_cid_type=pid}user/<extension>@<FS_SIP_DOMAIN>
# Set to the same IP as your FreeSWITCH server (FS_ESL_HOST for single-server deployments).
# When deployed via fs-cp, this is supplied automatically from the global SIP_DOMAIN value.
FS_SIP_DOMAIN=${SERVER_IP}


################################################################################
# JWT Authentication
################################################################################

# ★ 4 ── Replace with a random 32+ character string ───────────────────────────
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_32_CHARS_MINIMUM


################################################################################
# Docker port mapping  (change only if those ports are already in use)
################################################################################

BACKEND_PORT=4000
FRONTEND_PORT=8000
AGENT_DESKTOP_PORT=8080


################################################################################
# FreeSWITCH conf path  (optional — for callcenter.conf.xml generation)
# Set to your FS conf directory if you want the backend to write the XML file.
# Leave blank to skip writing (XML is still available via GET /api/queues/preview-xml)
################################################################################

# FS_CONF_PATH=/etc/freeswitch


################################################################################
# Frontend build  (do NOT change — relative paths work via Nginx proxy)
################################################################################

VITE_API_URL=/api
# VITE_SOCKET_URL is intentionally empty: Socket.IO connects to current origin
VITE_SOCKET_URL=


################################################################################
# Development overrides  (used only when running frontend/backend locally)
# These are ignored by docker-compose and the production build.
################################################################################

# Where the Vite dev server proxies /api and /socket.io during local dev.
# Keep as localhost:4000 if backend runs locally.
VITE_BACKEND_DEV_URL=http://localhost:4000

# Port for the Vite dev server (npm run dev)
VITE_DEV_PORT=5173
