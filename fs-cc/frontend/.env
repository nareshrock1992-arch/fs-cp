# ── Dev frontend .env ─────────────────────────────────────────────────────────
# Used when running "npm run dev" (Vite dev server).
# Docker Compose ignores this file — the build args in docker-compose.yml
# inject VITE_API_URL=/cc/api instead.

# Relative paths — Vite dev proxy forwards them to the backend.
# No IP address ever needed here.
VITE_API_URL=/api
VITE_SOCKET_PATH=/socket.io

# Where the Vite proxy sends /api and /socket.io requests during dev.
VITE_BACKEND_DEV_URL=http://localhost:4000

# Vite dev server port
VITE_DEV_PORT=5173
